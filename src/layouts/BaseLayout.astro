---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "No-dig, chemical-free vegetables and herbs grown on the Isle of Man." } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Family and the Field</title>
    <meta name="description" content={description} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Manrope:wght@400;500;600&display=swap" rel="stylesheet" />
    <!-- Snipcart CSS -->
    <link rel="stylesheet" href="https://cdn.snipcart.com/themes/v3.3.3/default/snipcart.css" />
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />

    <!-- Snipcart JS -->
    <script>
      window.SnipcartSettings = {
        publicApiKey: "YOUR_SNIPCART_PUBLIC_API_KEY",  // ← paste your key here
        loadStrategy: "on-user-interaction",
      };

      (function() {
        var c, d;
        (d = (c = window.SnipcartSettings).version) != null || (c.version = "3.3.3");
        var a, b;
        (b = (a = window.SnipcartSettings).timeoutDuration) != null || (a.timeoutDuration = 2750);
        var e, f;
        (f = (e = window.SnipcartSettings).domain) != null || (e.domain = "cdn.snipcart.com");
        var g, h;
        (h = (g = window.SnipcartSettings).protocol) != null || (g.protocol = "https");
        var i, j;
        (j = (i = window.SnipcartSettings).loadCSS) != null || (i.loadCSS = !0);
        var k = ["https://cdn.snipcart.com/themes/v3.3.3/default/snipcart.css"];
        window.SnipcartSettings.loadStrategy || (k.push("https://cdn.snipcart.com/themes/v3.3.3/default/snipcart.js"), document.head.appendChild(function(a) {
          var b = document.createElement("link");
          return b.rel = "stylesheet", b.href = a, b
        }(k[0])));
        var l = document.createElement("script");
        l.src = "https://cdn.snipcart.com/themes/v3.3.3/default/snipcart.js";
        l.async = !0;
        document.head.appendChild(l);
      })();
    </script>

    <div hidden id="snipcart" data-api-key="OWM0YmVmN2MtYzllNC00Y2FmLWJlODctNTI5Nzk2YmIwOTY2NjM5MjEzNDg1ODY3NjYxMzU4"></div>
  </body>
</html>