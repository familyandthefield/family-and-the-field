---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "No-dig, chemical-free vegetables and herbs grown on the Isle of Man.",
} = Astro.props;

const siteName = "Family and the Field";
const pageTitle = title === "Home"
  ? `${siteName} | No-dig market garden on the Isle of Man`
  : `${title} | ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL("/images/hero.jpg", Astro.site);
const snipcartPublicApiKey = "OWM0YmVmN2MtYzllNC00Y2FmLWJlODctNTI5Nzk2YmIwOTY2NjM5MjEzNDg1ODY3NjYxMzU4";
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  name: siteName,
  url: new URL("/", Astro.site).href,
  description: "No-dig, chemical-free vegetables and herbs grown on the Isle of Man.",
  areaServed: "Isle of Man",
  sameAs: ["https://www.instagram.com/familyandthefield/"],
});
---

<!DOCTYPE html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta name="theme-color" content="#FBF9F6" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={socialImage.href} />
    <meta property="og:image:width" content="1000" />
    <meta property="og:image:height" content="573" />
    <meta property="og:locale" content="en_GB" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage.href} />

    <script type="application/ld+json" set:html={jsonLd}></script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Manrope:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.snipcart.com/themes/v3.3.3/default/snipcart.css" />
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main" class="flex-grow">
      <slot />
    </main>
    <Footer />

    <script>
      import { installFulfilmentGuard } from "../scripts/fulfilment-cart";
      installFulfilmentGuard();
    </script>

    <script is:inline define:vars={{ snipcartPublicApiKey }}>
      window.SnipcartSettings = {
        publicApiKey: snipcartPublicApiKey,
        loadStrategy: "on-user-interaction",
        templatesUrl: "/snipcart-templates.html",
      };

      (function() {
        var c, d;
        (d = (c = window.SnipcartSettings).version) != null || (c.version = "3.3.3");
        var a, b;
        (b = (a = window.SnipcartSettings).timeoutDuration) != null || (a.timeoutDuration = 2750);
        var e, f;
        (f = (e = window.SnipcartSettings).domain) != null || (e.domain = "cdn.snipcart.com");
        var g, h;
        (h = (g = window.SnipcartSettings).protocol) != null || (g.protocol = "https");
        var i, j;
        (j = (i = window.SnipcartSettings).loadCSS) != null || (i.loadCSS = !0);
        var k = ["https://cdn.snipcart.com/themes/v3.3.3/default/snipcart.css"];
        window.SnipcartSettings.loadStrategy || (k.push("https://cdn.snipcart.com/themes/v3.3.3/default/snipcart.js"), document.head.appendChild(function(a) {
          var b = document.createElement("link");
          return b.rel = "stylesheet", b.href = a, b
        }(k[0])));
        var l = document.createElement("script");
        l.src = "https://cdn.snipcart.com/themes/v3.3.3/default/snipcart.js";
        l.async = !0;
        document.head.appendChild(l);
      })();
    </script>

    <div hidden id="snipcart" data-api-key={snipcartPublicApiKey} data-templates-url="/snipcart-templates.html"></div>
  </body>
</html>
