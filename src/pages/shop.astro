---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { produce, vegBoxes } from '../lib/products';

let products = [];
let boxes = [];

try {
  products = produce();
  boxes = vegBoxes();
} catch (error) {
  console.error('Error loading products:', error);
}
---

<BaseLayout
  title="Shop"
  description="What’s ready this week. Everything is harvested to order. Availability changes with the season and the weather."
>
  <section class="max-w-6xl mx-auto px-4 py-16">
    <h1 class="font-serif text-3xl md:text-4xl text-ink-900 mb-4">Shop</h1>
    <p class="text-lg text-ink-700 mb-2">What’s ready this week</p>
    <p class="text-ink-700 mb-12 max-w-2xl">
      Everything is harvested to order. Availability changes with the season and the weather — that’s the nature of real food.
    </p>

    {products.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {products.map((product) => (
          <ProductCard {...product} />
        ))}
      </div>
    ) : (
      <p class="text-ink-700">No products available at the moment. Please check back soon.</p>
    )}

    <section class="mt-16" aria-labelledby="veg-boxes-heading">
      <h2 id="veg-boxes-heading" class="font-serif text-2xl md:text-3xl text-ink-900 mb-3">Veg boxes</h2>
      {boxes.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
          {boxes.map((product) => (
            <ProductCard {...product} />
          ))}
        </div>
      ) : (
        <p class="text-ink-700">Veg boxes coming for the new season.</p>
      )}
    </section>

    <div class="mt-16 pt-8 border-t border-cream-200 text-ink-700">
      <p class="mb-2"><strong>Pickup</strong> is free at Noa Bakehouse.</p>
      <p>Home delivery available on orders over £20 (two working days’ lead time, 12:00–19:00 window).</p>
      <p class="mt-2">At checkout, choose Collect from Noa Bakehouse, Douglas (free), or home delivery.</p>
    </div>
  </section>
</BaseLayout>