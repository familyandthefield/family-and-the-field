---
export const prerender = false;

import BaseLayout from "../layouts/BaseLayout.astro";
import HarvestBoard from "../components/HarvestBoard.astro";
import { loadSeason, SEASON_CACHE_CONTROL } from "../lib/load-season";

const season = await loadSeason();
Astro.response.headers.set("Cache-Control", SEASON_CACHE_CONTROL);
---

<BaseLayout
  title="Harvest"
  description="What’s being sown, transplanted and harvested in the garden this week, and the season plan for the year."
>
  <HarvestBoard season={season} />
</BaseLayout>
