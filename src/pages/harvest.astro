---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Harvest"
  description="What’s ready this week is listed in the shop. Everything is harvested to order."
>
  <section class="max-w-2xl mx-auto px-4 py-16 md:py-24">
    <h1 class="font-serif text-3xl md:text-4xl text-ink-900 mb-8">Harvest</h1>
    <div class="text-ink-700 space-y-6 leading-relaxed">
      <p>Everything is harvested to order. Availability changes with the season and the weather.</p>
      <p>What’s ready this week is listed in the shop.</p>
      <p>
        <a href="/shop" class="text-leaf-700 hover:text-leaf-600 underline underline-offset-4">View the shop</a>
      </p>
    </div>
  </section>
</BaseLayout>
