---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import HarvestingNowStrip from '../components/HarvestingNowStrip.astro';
import { produce, vegBoxes } from '../lib/products';
import { loadSeason } from '../lib/load-season';
import { buildSeasonView } from '../lib/season-plan';

let products = [];
let boxes = [];

try {
  products = produce();
  boxes = vegBoxes();
} catch (error) {
  console.error('Error loading products:', error);
}

let season;
try {
  season = await loadSeason();
} catch (error) {
  console.error('Error loading the season plan:', error);
  season = {
    view: buildSeasonView({ varieties: [] }, new Date()),
    source: "unavailable" as const,
    fetchedAt: null,
  };
}
---

<BaseLayout title="Home">
  <!-- Hero -->
  <section class="relative">
    <div class="aspect-[16/9] md:aspect-[21/9] bg-cream-200 overflow-hidden">
      <img
        src="/images/hero.jpg"
        alt="Illustrated plan of the garden, with beds, a greenhouse, hens and trees"
        width="1000"
        height="573"
        fetchpriority="high"
        decoding="async"
        class="w-full h-full object-cover"
      />
    </div>
    <div class="max-w-3xl mx-auto px-4 -mt-20 md:-mt-28 relative z-10 text-center">
      <div class="bg-cream-50/95 backdrop-blur rounded-2xl p-8 md:p-12 shadow-sm border border-cream-200">
        <h1 class="font-serif text-3xl md:text-5xl text-ink-900 mb-4">Family and the Field</h1>
        <p class="text-lg text-ink-700 mb-8">
          No-dig. Chemical-free. Grown for our community on the Isle of Man.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/csa" class="bg-leaf-600 hover:bg-leaf-700 text-cream-50 px-6 py-3 rounded-lg transition-colors">
            Join the 2026 CSA
          </a>
          <a href="#shop" class="border border-leaf-600 text-leaf-700 hover:bg-leaf-50 px-6 py-3 rounded-lg transition-colors">
            View the Shop
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Story / Mission -->
  <section class="max-w-2xl mx-auto px-4 py-20 text-center">
    <h2 class="font-serif text-2xl md:text-3xl text-ink-900 mb-6">Our Story</h2>
    <p class="text-lg text-ink-700 leading-relaxed mb-6">
      We grow food the way we want to eat it — slowly, carefully, and without synthetic chemicals.
    </p>
    <p class="text-ink-700 leading-relaxed mb-6">
      One acre of no-dig beds, rotated with care, for better flavour, better nutrition, and a healthier planet.
    </p>
    <p class="text-ink-700 italic">Always learning.</p>
    <a href="/our-story" class="inline-block mt-8 text-leaf-700 hover:text-leaf-600 underline underline-offset-4 text-sm">
      Read more about how we grow →
    </a>
  </section>

  <HarvestingNowStrip season={season} />

  <!-- Shop section on homepage -->
  <section id="shop" class="bg-cream-100 border-t border-cream-200">
    <div class="max-w-6xl mx-auto px-4 py-16">
      <div class="text-center mb-12">
        <h2 class="font-serif text-2xl md:text-3xl text-ink-900 mb-3">What’s ready this week</h2>
        <p class="text-ink-700 max-w-xl mx-auto">
          Everything is harvested to order. Availability changes with the season and the weather.
        </p>
      </div>

      {products.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
          {products.map((product) => (
            <ProductCard {...product} />
          ))}
        </div>
      ) : (
        <p class="text-center text-ink-700">Nothing available right now — check back soon.</p>
      )}

      {boxes.length > 0 && (
        <div class="mt-16">
          <h2 class="font-serif text-2xl text-ink-900 mb-8 text-center">Veg boxes</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
            {boxes.map((product) => (
              <ProductCard {...product} />
            ))}
          </div>
        </div>
      )}

      <div class="text-center mt-12">
        <a href="/shop" class="text-leaf-700 hover:text-leaf-600 underline underline-offset-4 text-sm">
          View full shop →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>