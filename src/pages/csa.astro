---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="CSA"
  description="No-dig, chemical-free vegetables and herbs grown for our community on the Isle of Man."
>
  <section class="max-w-2xl mx-auto px-4 py-16 md:py-24">
    <h1 class="font-serif text-3xl md:text-4xl text-ink-900 mb-8">CSA</h1>
    <div class="text-ink-700 space-y-6 leading-relaxed">
      <p>No-dig. Chemical-free. Grown for our community on the Isle of Man.</p>
      <p>How to join is not published on this page yet.</p>
      <p>
        <a href="/shop" class="text-leaf-700 hover:text-leaf-600 underline underline-offset-4">See what’s ready this week</a>
      </p>
    </div>
  </section>
</BaseLayout>
