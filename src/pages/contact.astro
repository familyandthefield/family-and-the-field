---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact"
  description="Pickup is free at Noa Bakehouse. Home delivery is available on orders over £20."
>
  <section class="max-w-2xl mx-auto px-4 py-16 md:py-24">
    <h1 class="font-serif text-3xl md:text-4xl text-ink-900 mb-8">Contact</h1>
    <div class="text-ink-700 space-y-6 leading-relaxed">
      <p>Pickup is free at Noa Bakehouse.</p>
      <p>Home delivery is available on orders over £20 (two working days’ lead time, 12:00–19:00 window).</p>
      <p>
        <a href="https://www.instagram.com/familyandthefield/" class="text-leaf-700 hover:text-leaf-600 underline underline-offset-4">Instagram</a>
      </p>
    </div>
  </section>
</BaseLayout>
