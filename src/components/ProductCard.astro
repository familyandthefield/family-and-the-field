---
interface Props {
  id: string;
  name: string;
  price: string;
  description?: string;
  image?: string;
  alt?: string;
  width?: number;
  height?: number;
  paymentLink?: string; // no longer needed, but kept for compatibility
}

const { id, name, price, description, image, alt, width, height } = Astro.props;

// Convert "£3.00" → 3.00 for Snipcart
const numericPrice = parseFloat(price.replace("£", "").replace(",", "."));
const itemUrl = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = image ? new URL(image, Astro.site).href : "";
---

<article class="bg-cream-100 rounded-xl overflow-hidden border border-cream-200 flex flex-col h-full">
  <div class="aspect-square bg-cream-200 overflow-hidden">
    {image ? (
      <img 
        src={image} 
        alt={alt || name}
        width={width}
        height={height}
        class="w-full h-full object-cover"
        loading="lazy"
        decoding="async"
        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
      />
    ) : null}
    <div class="w-full h-full hidden items-center justify-center text-ink-700/40 text-sm">
      No image
    </div>
  </div>

  <div class="p-5 flex flex-col flex-grow">
    <h3 class="text-lg font-medium text-ink-900 mb-1">{name}</h3>
    <p class="text-leaf-700 font-medium mb-3">{price}</p>
    
    {description && (
      <p class="text-sm text-ink-700 mb-4 flex-grow leading-relaxed">
        {description}
      </p>
    )}

    <button
      type="button"
      class="mt-auto snipcart-add-item inline-block text-center bg-leaf-600 hover:bg-leaf-700 text-cream-50 px-4 py-2.5 rounded-lg transition-colors text-sm font-medium w-full"
      data-item-id={id}
      data-item-name={name}
      data-item-price={numericPrice}
      data-item-url={itemUrl}
      data-item-description={description || ""}
      data-item-image={imageUrl}
    >
      Add to Cart
    </button>
  </div>
</article>